using Microsoft.AspNetCore.Mvc;

namespace RaceDayMVC.Controllers;

public class ParticipantController : Controller
{
    public IActionResult Index()
    {
        var role =
            HttpContext.Session.GetString("Role");

        if(role != "Participant")
        {
            return RedirectToAction(
                "Login",
                "Account");
        }

        return View();
    }
}
